#!/usr/bin/env bash
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=ak2877@cornell.edu
# GPU job: counterfactual + natural-order evaluation of one reader (lae/counterfactual.py).
# Inputs (env): CF_NAME ("frozen" or a train run name), ADAPTER (empty = frozen reader).
set -euo pipefail
: "${PROJ:?PROJ not set; run via scripts/07_counterfactual.sh}"
: "${CF_NAME:?}"
source "$PROJ/scripts/config.sh"
source "$PROJ/scripts/lib.sh"
mkdirs

STAGE="cf_${CF_NAME}"
OUT="$RUNS_DIR/counterfactual/$CF_NAME"
trap 'rc=$?; [[ $rc -ne 0 ]] && mark_failed $STAGE "exit $rc job ${SLURM_JOB_ID:-local}"; exit $rc' EXIT
log "counterfactual $CF_NAME  adapter=${ADAPTER:-<none, frozen>}  host $(hostname)  job ${SLURM_JOB_ID:-local}"
nvidia-smi --query-gpu=name,memory.used,memory.total --format=csv,noheader | sed 's/^/   GPU: /'

need_file "$RUNS_DIR/p17_repro/predictions_k10_first.jsonl" "(run the reproduction first)"
need_file "$RUNS_DIR/p17_repro/retrieval_p17.jsonl"
if [[ -n "${ADAPTER:-}" ]]; then need_file "$ADAPTER/adapter_model.safetensors"; fi
cd "$AUTHORS_DIR"
LAE_ADAPTER="${ADAPTER:-}" "$PY" "$PROJ/lae/counterfactual.py" \
  --authors-dir "$AUTHORS_DIR" --frozen "$RUNS_DIR/p17_repro" --out "$OUT"
need_file "$OUT/summary.json"
mark_ok "$STAGE" "job ${SLURM_JOB_ID:-local} -> $OUT"
log "$STAGE OK"
